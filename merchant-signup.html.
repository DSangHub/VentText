<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VentText — Create your business profile</title>
<link rel="stylesheet" href="styles.css">
<style>
  .join { max-width: 560px; margin: 0 auto; padding: 52px 28px 80px; }
  .join h1 { font-family: var(--mono); font-size: 1.9rem; margin-bottom: 8px; }
  .join .lead { color: var(--muted); margin-bottom: 26px; }
  .form-card { background: var(--paper-100); color: var(--paper-ink); border-radius: 14px; padding: 26px; }
  .form-card label { display: block; font-weight: 600; color: var(--ink-900); margin: 0 0 6px; font-size: .95rem; }
  .form-card input[type="tel"], .form-card input[type="text"], .form-card input[type="email"], .form-card select {
    width: 100%; padding: 11px 13px; border: 1px solid #c9c1b0; border-radius: 8px; font-size: 1rem;
    background: #fff; color: var(--ink-900); margin-bottom: 16px; }
  .note { font-size: .78rem; color: var(--muted-dark); margin-top: 12px; }
  .join button { margin-top: 6px; width: 100%; background: var(--stamp-red); color: #fff; border: none;
    padding: 12px; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer; }
  .join button:disabled { opacity: .5; cursor: not-allowed; }
  .join a { color: var(--resolve-green-dim); text-decoration: underline; }
  .ok { display: none; background: rgba(47,158,122,.12); border-left: 3px solid var(--resolve-green);
    padding: 14px 16px; border-radius: 8px; color: var(--paper-100); margin-top: 20px; }
  .ok a { color: var(--resolve-green); }
</style>
</head>
<body>

<nav class="nav">
  <div class="nav-inner">
    <div class="logo"><span class="dot"></span>VentText</div>
    <div class="nav-links">
      <a href="index.html">Home</a>
      <a href="how-it-works.html">How It Works</a>
      <a href="merchants.html">For Merchants</a>
      <a href="dashboard.html">Business Login</a>
      <a href="faq.html">FAQ</a>
      <a href="join.html">Sign Up</a>
    </div>
    <a href="sms:+15595505388?&amp;body=Hi%20VentText%2C%20I%20had%20a%20bad%20experience." class="btn btn-primary">Text Us Now</a>
  </div>
</nav>

<main class="join">
  <h1>Create your business profile</h1>
  <p class="lead">Tell us about your business and we'll set up your VentText dashboard — usually within one business day. Already have login details? <a href="dashboard.html">Go to Business Login</a> instead.</p>

  <div class="form-card">
    <form id="signupForm" novalidate>
      <label for="bizName">Business name</label>
      <input type="text" id="bizName" name="bizName" autocomplete="organization" required>

      <label for="contactName">Your name</label>
      <input type="text" id="contactName" name="contactName" autocomplete="name" required>

      <label for="phone">Business phone number</label>
      <input type="tel" id="phone" name="phone" placeholder="(555) 555-5555" autocomplete="tel" required>

      <label for="email">Email</label>
      <input type="email" id="email" name="email" autocomplete="email" required>

      <label for="locations">Number of locations</label>
      <select id="locations" name="locations">
        <option value="1">1 location</option>
        <option value="2-5">2–5 locations</option>
        <option value="6+">6+ locations</option>
      </select>

      <button type="submit" id="submitBtn">Request my dashboard</button>
      <p class="note">We'll text or email the number/address above to verify you're the business owner before your dashboard goes live — same as claiming a listing.</p>
    </form>

    <div class="ok" id="okMsg"></div>
  </div>
</main>

<footer>
  <div class="wrap footer-inner">
    <div>© 2026 VentText — a service of Lazy Man Ventures LLC.</div>
    <div class="footer-links">
      <a href="how-it-works.html">How It Works</a>
      <a href="merchants.html">For Merchants</a>
      <a href="dashboard.html">Business Login</a>
      <a href="faq.html">FAQ</a>
      <a href="join.html">Sign Up for Texts</a>
      <a href="privacy.html">Privacy</a>
      <a href="terms.html">SMS Terms</a>
    </div>
  </div>
</footer>

<script>
  var form = document.getElementById('signupForm');
  var ok = document.getElementById('okMsg');
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var biz = document.getElementById('bizName').value.trim();
    var contact = document.getElementById('contactName').value.trim();
    var phone = document.getElementById('phone').value.trim();
    var email = document.getElementById('email').value.trim();
    if (!biz || !contact || !phone || !email) {
      alert('Please fill in your business name, your name, phone, and email.');
      return;
    }
    form.style.display = 'none';
    ok.style.display = 'block';
    ok.innerHTML = "Thanks, " + contact.replace(/[<>]/g,'') + "! We've got a profile started for <strong>" +
      biz.replace(/[<>]/g,'') + "</strong>. We'll reach out at <strong>" + phone.replace(/[<>]/g,'') +
      "</strong> or <strong>" + email.replace(/[<>]/g,'') +
      "</strong> to verify your business and send your dashboard login. Questions in the meantime? Text us at <strong>+1 (559) 550-5388</strong>.";
  });
</script>
</body>
</html>
